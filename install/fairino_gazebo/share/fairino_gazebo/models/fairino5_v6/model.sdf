    <!-- Plugin ros2_control untuk Gazebo Harmonic -->
    <plugin name="gz_ros2_control" filename="libgz_ros2_control-system.so">
      <ros>
        <namespace>/fr5</namespace>
      </ros>
      <parameters>model://fairino5_v6/controllers.yaml</parameters>
    </plugin>

    <!-- Definisi ros2_control: map joint ke posisi -->
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSystem</plugin>
      </hardware>

      <joint name="j1">
        <command_interfaces>position</command_interfaces>
        <state_interfaces>position</state_interfaces>
      </joint>
      <joint name="j2">
