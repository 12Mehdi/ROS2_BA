<sdf version='1.9'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>

      <!-- WAJIB: Tambahkan ini agar Kamera & Depth bekerja -->
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>


    <!-- ========================= -->
    <!--      MODEL 1: Table       -->
    <!-- ========================= -->
    <model name="box_target">
      <static>true</static>
      <pose>0.5 0 0.0625 0 0 0</pose>

      <link name="main_block">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.6 0.125</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.6 0.125</size>
            </box>
          </geometry>
          <material>
            <ambient>0.545 0.271 0.075 1</ambient>
            <diffuse>0.545 0.271 0.075 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!--      MODEL: 2 Cross       -->
    <!--   digabung jadi 1 model   -->
    <!-- ========================= -->
    <model name="Cross">
      <static>false</static>
      <!-- Pose model = referensi dunia untuk semua link.
           Kita set supaya posisi mid_small_block tetap di (0.56, 0.015, 0.135)
           dengan pose lokal (0,0,0). -->
      <pose>0.56 0.015 0.135 0 0 0.78</pose>

      <!-- Link pusat: mid_small_block -->
      <link name="mid_small_block">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.03 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Link 1: small_block (aslinya di 0.58, 0, 0.135) -->
      <!-- Offset terhadap mid_small_block (0.56, 0.015, 0.135):
           dx = 0.58 - 0.56 = 0.02
           dy = 0    - 0.015 = -0.015
           dz = 0    (sama tinggi) -->
      <link name="small_block">
        <pose>0.02 -0.015 0 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 0.03 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Link 2: extra_small_block (aslinya di 0.58, 0.03, 0.135) -->
      <!-- Offset terhadap mid_small_block:
           dx = 0.58 - 0.56 = 0.02
           dy = 0.03 - 0.015 = 0.015 -->
      <link name="extra_small_block">
        <pose>0.02 0.015 0 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 0.03 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Link 3: top_small_block (aslinya di 0.6, 0.015, 0.135) -->
      <!-- Offset terhadap mid_small_block:
           dx = 0.6 - 0.56 = 0.04
           dy = 0.015 - 0.015 = 0 -->
      <link name="top_small_block">
        <pose>0.04 0 0 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 0.03 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Joints: hubungkan semua ke mid_small_block sebagai fixed joint -->
      <joint name="joint_small_mid" type="fixed">
        <parent>mid_small_block</parent>
        <child>small_block</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <joint name="joint_extra_mid" type="fixed">
        <parent>mid_small_block</parent>
        <child>extra_small_block</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <joint name="joint_top_mid" type="fixed">
        <parent>mid_small_block</parent>
        <child>top_small_block</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

    </model>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
