<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <xacro:macro name="depth_camera" params="parent">

    <joint name="depth_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="depth_camera_link"/>
      <origin xyz="0.011 -0.0649 0.129" rpy="1.571 3.142 1.571"/>
    </joint>

    <link name="depth_camera_link">
      <visual>
        <geometry>
          <box size="0.01 0.03 0.03"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Frame optik untuk pengolahan data pointcloud/image di ROS -->
    <joint name="depth_camera_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="depth_camera_optical_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="depth_camera_optical_link"/>

    <gazebo reference="depth_camera_link">
      <sensor name="depth_camera" type="rgbd">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>depth_camera</topic>
        <!-- Penting: Mengarahkan output data ke frame optik -->
        <gz_frame_id>depth_camera_optical_link</gz_frame_id>
        
        <camera>
          <horizontal_fov>1.52</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
