<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Include ros2_control macro for gripper -->
  <xacro:include filename="$(find schnuck_fr_description)/urdf/schnuck_gripper.ros2_control.xacro" />

  <!-- ===================== -->
  <!-- Gripper macro -->
  <!-- ===================== -->
  <xacro:macro name="gripper" params="parent">

    <!-- Base link -->
    <link name="gripper_base_link">
      <inertial>
        <origin xyz="0.009 0.001 0.047"/>
        <mass value="0.078"/>
        <inertia ixx="0.002176" ixy="-0.000078" ixz="0.000214" 
                 iyy="0.002057" iyz="0.000029" 
                 izz="0.001833"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://schnuck_fr_description/meshes/collision/schnuck_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gray">
          <color rgba="0.6 0.6 0.6 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://schnuck_fr_description/meshes/collision/schnuck_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- ===================== -->
    <!-- finger macro -->
    <!-- ===================== -->
    <xacro:macro name="finger" params="name rpy mesh">
      <link name="${name}">
        <inertial>
          <origin xyz="0.000 -0.025 0.103"/>
          <mass value="0.006"/>
          <inertia ixx="0.000035" ixy="-1e-9" ixz="1e-9"
                   iyy="0.000022" iyz="-0.000003"
                   izz="0.00002"/>
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="${rpy}"/>
          <geometry>
            <mesh filename="${mesh}" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="blue">
            <color rgba="0.2 0.4 0.9 1"/>
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${rpy}"/>
          <geometry>
            <mesh filename="${mesh}" scale="0.001 0.001 0.001"/>
          </geometry>
        </collision>
      </link>
    </xacro:macro>

    <!-- finger links -->
    <xacro:finger
      name="left_finger"
      rpy ="0 0 ${pi}"
      mesh="package://schnuck_fr_description/meshes/collision/schnuck_finger.stl"/>
    <xacro:finger
      name="right_finger"
      rpy ="0 0 0"
      mesh="package://schnuck_fr_description/meshes/collision/schnuck_finger.stl"/>

    <joint name="gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0.0995" rpy="0 0 ${-pi/2}"/>   <!--  -Y untuk ke bawah -->
      <axis xyz="0 0 0"/>
    </joint>

    <!-- finger joints -->
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="left_finger"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.001" upper="0.01" velocity="0.03" effort="70"/>
      <dynamics damping="0.05" friction="0.01"/>
    </joint>

    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="right_finger"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.01" upper="0.001" velocity="0.03" effort="70"/>
      <dynamics damping="0.05" friction="0.01"/>
      <mimic joint="left_finger_joint" multiplier="-1" offset="0"/>
    </joint>

    <!-- Add ros2_control tags for the gripper -->
    <xacro:gripper_ros2_control/>

  </xacro:macro>

</robot>
